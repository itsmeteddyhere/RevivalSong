<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevivalSong.ViewModels"
        x:Class="RevivalSong.Views.NewSongWindow"
        x:DataType="vm:NewSongViewModel"
        Background="#18181b"
        Width="860" Height="760"
        WindowStartupLocation="CenterOwner"
        Title="Add Song">

    <Grid RowDefinitions="Auto, *, Auto" Margin="15">

        <Border Grid.Row="0" Background="#27272a" CornerRadius="6" Padding="10" Margin="0,0,0,15">
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *, Auto, *, Auto, *">

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Song #:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SongNumber}" Margin="0,0,15,10"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Type:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <ComboBox Grid.Row="0" Grid.Column="3" SelectedItem="{Binding SongType}" Margin="0,0,15,10" HorizontalAlignment="Stretch">
                    <ComboBoxItem>worship</ComboBoxItem>
                    <ComboBoxItem>hymn</ComboBoxItem>
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Lang Order:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <Grid Grid.Row="0" Grid.Column="5" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                    <TextBox Grid.Column="0" Text="{Binding LangOrder}"/>
                    <Button Grid.Column="1" Content="Update" Command="{Binding UpdateTabsCommand}" Margin="5,0,0,0" Background="#3f3f46"/>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="GSN:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gsn}" Margin="0,0,15,10"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="GRK:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Grk}" Margin="0,0,15,10"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Key / Time / BPM:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <Grid Grid.Row="1" Grid.Column="5" ColumnDefinitions="*, *, *" Margin="0,0,0,10">
                    <TextBox Grid.Column="0" Text="{Binding DefaultKey}" PlaceholderText="Key" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" Text="{Binding TimeSignature}" PlaceholderText="4/4" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="2" Text="{Binding Bpm}" PlaceholderText="BPM"/>
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Author:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Author}" Margin="0,0,15,10"/>

                <TextBlock Grid.Row="2" Grid.Column="4" Text="CCLI / Year:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <Grid Grid.Row="2" Grid.Column="5" ColumnDefinitions="*, *" Margin="0,0,0,10">
                    <TextBox Grid.Column="0" Text="{Binding Ccli}" PlaceholderText="CCLI #" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Year}" PlaceholderText="Year"/>
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Assembly:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Assembly}" Margin="0,0,15,10"/>

                <TextBlock Grid.Row="3" Grid.Column="4" Text="Scripture:" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="3" Grid.Column="5" Text="{Binding Scripture}" Margin="0,0,0,10"/>

                <!-- Row 4 -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Copyright:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Copyright}" Margin="0,0,15,0"/>

                <TextBlock Grid.Row="4" Grid.Column="4" Text="Created By:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="4" Grid.Column="5" Text="{Binding CreatedBy}" Margin="0,0,0,0"/>

            </Grid>
        </Border>

        <TabControl Grid.Row="1" ItemsSource="{Binding LanguageTabs}">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageEditModel">
                    <TextBlock Text="{Binding LangCode}" FontWeight="Bold"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:LanguageEditModel">
                    <Grid RowDefinitions="Auto, *" Margin="0, 10, 0, 0">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, *" RowDefinitions="Auto, Auto" Margin="0,0,0,10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title}" Margin="0,0,15,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Alt Title:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding AltTitle}" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Translator:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Translator}" Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Order:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding StanzaOrder}" PlaceholderText="V1, C, V2..."/>
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Stanzas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StanzaEditModel">
                                        <Border Background="#27272a" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                            <Grid RowDefinitions="Auto, *">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto" Margin="0,0,0,5">
                                                    <!-- original 6 dropdown options -->
                                                    <ComboBox Grid.Column="0" ItemsSource="{Binding SectionOptions}" SelectedItem="{Binding SectionType}" Margin="0,0,5,0" Width="110"/>
                                                    <TextBox Grid.Column="1" Text="{Binding SectionNumber}" PlaceholderText="#" Width="40" Margin="0,0,5,0"/>
                                                    <TextBox Grid.Column="2" Text="{Binding Label}" PlaceholderText="Label" Width="100" Margin="0,0,5,0"/>
                                                    <TextBox Grid.Column="3" Text="{Binding KeyChange}" PlaceholderText="Key" Width="50" Margin="0,0,5,0"/>
                                                    <CheckBox Grid.Column="4" Content="Split ( )" IsChecked="{Binding SplitParenthesis}"/>
                                                    <Button Grid.Column="5" Content="✕" Command="{Binding RemoveCommand}" Background="#dc2626" Foreground="White" FontWeight="Bold"/>
                                                </Grid>
                                                <TextBox Grid.Row="1" Text="{Binding Lyrics}" AcceptsReturn="True" Height="80"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="1" Content="+ Add Stanza" Command="{Binding AddStanzaCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Background="#3f3f46"/>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Button Grid.Row="2" Content="Save Complete Song Record" Command="{Binding SaveSongCommand}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Background="#28a745" Foreground="White" FontWeight="Bold" FontSize="16" Padding="10" Margin="0,15,0,0"/>

    </Grid>
</Window>