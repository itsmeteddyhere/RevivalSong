<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevivalSong.ViewModels"
        x:Class="RevivalSong.Views.ProjectorWindow"
        x:DataType="vm:ProjectorViewModel"
        Background="Black"
        SystemDecorations="None"
        WindowState="FullScreen"
        Topmost="True"
        Title="Projector">

    <Grid RowDefinitions="Auto, *, Auto" Margin="40">

        <Grid Grid.Row="0" ColumnDefinitions="*, 2*, *">
            <TextBlock Grid.Column="0" Text="{Binding SongNumber}" Foreground="#a1a1aa" FontSize="30" FontWeight="Bold" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding KeyText}" Foreground="#a1a1aa" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0, 20">
            <TextBlock Text="{Binding Lyrics}" Foreground="White" FontWeight="Bold" TextAlignment="Left" TextWrapping="NoWrap"/>
        </Viewbox>

        <TextBlock Grid.Row="2" Text="{Binding CounterText}" Foreground="#a1a1aa" FontSize="25" FontWeight="Bold" HorizontalAlignment="Right"/>
    </Grid>
</Window>