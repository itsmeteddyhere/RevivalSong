<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RevivalSong.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:m="clr-namespace:RevivalSong.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RevivalSong.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="RevivalSong">
    <TabControl x:Name="MainTabControl" Background="#111">
        <TabItem Header="Songs" FontSize="18">
            <Grid ColumnDefinitions="300, 40, *">
        <Border Grid.Column="0" Background="#111" Padding="10">
            <Grid RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Search song or number..."
                             Text="{Binding SearchQuery}" />
                    <Button Grid.Column="1"
                            Content="New Song"
                            Background="#28a745"
                            Foreground="White"
                            Margin="10,0,0,0"
                            Command="{Binding OpenNewSongDialogCommand}"/>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,0,0,10">
                    <Button Grid.Column="0"
                            Content="Local"
                            Background="#1f538d"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,5,0" />
                    <Button Grid.Column="1" Content="Global"
                            Background="#333"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="5,0,0,0"/>
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SearchSelectedSong, Mode=TwoWay}"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Song">
                            <Grid ColumnDefinitions="40, *">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit Song..."
                                                  Command="{Binding $parent[Window].DataContext.EditSongCommand}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Grid.Column="0" Text="{Binding SongNumber}" Padding="6"
                                           Foreground="#60a5fa" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" Text="{Binding PrimaryTitle}" Foreground="#f4f4f5" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto" Background="#222">
            <Button Grid.Row="0" Content="-&gt;" HorizontalAlignment="Center" Margin="0, 100, 0, 0" Command="{Binding AddSongToSonglistCommand}"/>
        </Grid>
        <Border Grid.Column="2" Background="#222" Padding="0, 10, 10, 10">
            <Grid RowDefinitions="*, Auto">
                <Grid ColumnDefinitions="*, 5, *">
                <Grid Grid.Column="0" RowDefinitions="Auto, *, 5, *">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto">
                        <DropDownButton Grid.Column="0" Content="{Binding SelectedSonglistTitle}" Foreground="White" Background="#444" Margin="0,0,5,0">
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ListBox ItemsSource="{Binding Songlists}"
                                             SelectedItem="{Binding SelectedSonglist}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}"></TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button Grid.Column="1" Content="+" Foreground="White" Background="#444" Margin="0,0,5,0" Width="30" HorizontalContentAlignment="Center" Command="{Binding MakeNewSonglistCommand}"/>
                        <Button Grid.Column="2" Content="Print" Command="{Binding PrintSonglistCommand}" Foreground="White" Background="#444" Margin="0,0,5,0"/>
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="0,10,0,0">
                        <TextBlock Grid.Row="0" Text="current songlist" Foreground="#aaa" Margin="0,0,0,10" />

                        <ListBox x:Name="SonglistBox"
                                 Grid.Row="1" Background="#111"
                                 ItemsSource="{Binding SelectedSonglistSongs}"
                                 SelectedItem="{Binding SonglistSelectedSong, Mode=TwoWay}"
                                 DragDrop.AllowDrop="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="40, *">
                                        <TextBlock Grid.Column="0" Text="{Binding SongNumber}" Padding="6"
                                                   Foreground="#60a5fa" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding PrimaryTitle}" Foreground="#f4f4f5" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <GridSplitter Grid.Row="2" Background="#222" ResizeDirection="Rows" Margin="0,10,0,10"/>

                    <Grid Grid.Row="3" RowDefinitions="Auto, *">
                        <TextBlock Grid.Row="0" Text="live stanzas" Foreground="#aaa" Margin="0,0,0,10" />

                        <ListBox Grid.Row="1" Background="#111"
                                 ItemsSource="{Binding CurrentStanzas}"
                                 SelectedItem="{Binding SelectedStanza, Mode=TwoWay}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="m:Stanza">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="IsHitTestVisible" Value="{Binding !Disabled}" />
                                    <Setter Property="Focusable" Value="{Binding !Disabled}" />
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Padding="12,8" Background="{Binding BgColor}">
                                            <Grid ColumnDefinitions="40, *">
                                                <TextBlock Grid.Column="0" Text="{Binding Language}" Padding="6"
                                                           Foreground="{Binding LangFgColor}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{Binding NameFgColor}" HorizontalAlignment="Left" VerticalAlignment="Center"></TextBlock>
                                            </Grid>
                                        </Border>

                                        <Border IsVisible="{Binding Disabled}" IsHitTestVisible="False" Opacity="0.5">
                                            <Border.Background>
                                                <VisualBrush TileMode="Tile" SourceRect="0,0,16,16" DestinationRect="0,0,16,16">
                                                    <VisualBrush.Visual>
                                                        <Canvas Width="16" Height="16">
                                                            <Line StartPoint="-2,18" EndPoint="18,-2" Stroke="#aaa" StrokeThickness="1" />

                                                            <Line StartPoint="-2,2" EndPoint="2,-2" Stroke="#aaa" StrokeThickness="1" />

                                                            <Line StartPoint="14,18" EndPoint="18,14" Stroke="#aaa" StrokeThickness="1" />
                                                        </Canvas>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                </Grid>
                <GridSplitter Grid.Column="1" Background="#222" ResizeDirection="Columns" Margin="10, 0, 10, 0"/>
                <Grid Grid.Column="2" RowDefinitions="*, *, *, Auto">
                    <Grid Grid.Row="0" RowDefinitions="Auto, *" Margin="15,0,0,0">
                        <TextBlock Grid.Row="0" Text="previous stanza" Foreground="#aaa" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Background="#111" Text="{Binding PreviousStanzaText}"></TextBlock>
                    </Grid>
                    <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="15,10,0,0">
                        <TextBlock Grid.Row="0" Text="current stanza" Foreground="#aaa" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Background="#045" Text="{Binding CurrentStanzaText}"></TextBlock>
                    </Grid>
                    <Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="15,10,0,0">
                        <TextBlock Grid.Row="0" Text="next stanza" Foreground="#aaa" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Background="#111" Text="{Binding NextStanzaText}"></TextBlock>
                    </Grid>
                </Grid>

            </Grid>
            <Grid Row="1" ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *" Margin="0, 5, 0, 0">
                <Button Grid.Column="0" Command="{Binding PreviousStanzaCommand}">↑</Button>
                <Button Grid.Column="1" Command="{Binding NextStanzaCommand}" Margin="2, 0, 2, 0">↓</Button>
                <Button Grid.Column="2" Command="{Binding PreviousSongCommand}" Margin="2, 0, 0, 0">←</Button>
                <Button Grid.Column="3" Command="{Binding NextSongCommand}" Margin="2, 0, 0, 0">→</Button>
                <Button Grid.Column="4" Content="{Binding EndingSkippedBtnTxt}" Background="{Binding EndingSkippedBtnClr}" Foreground="White" Margin="5,0,0,0" Command="{Binding EndingSkippedBtnCommand}"/>
                <Button Grid.Column="5" Content="Toggle projection" Foreground="White" Margin="5,0,0,0" Command="{Binding ToggleProjectorCommand}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
    </Grid>
        </TabItem>
        <TabItem Header="Bible" FontSize="18">
            <Grid ColumnDefinitions="300, *">
                
                <!-- Left Panel: Controls and Scripture List -->
                <Border Grid.Column="0" Background="#111" Padding="10">
                    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                        <!-- Search box -->
                        <TextBox Grid.Row="0" Watermark="Search reference (e.g. Genesis 1:3)" Text="{Binding BibleSearchQuery}" Margin="0,0,0,10" Foreground="White" Background="#444" BorderBrush="#444"/>
                        
                        <!-- Translation picker -->
                        <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableTranslations}" SelectedItem="{Binding SelectedTranslation}" PlaceholderText="Translation" Margin="0,0,0,10" HorizontalAlignment="Stretch" Foreground="White" Background="#444" BorderBrush="#444">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:BibleTranslation">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <!-- Scripture list picker -->
                        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Scripturelists}"
                                      SelectedItem="{Binding SelectedScripturelist}"
                                      PlaceholderText="Scripture List"
                                      HorizontalAlignment="Stretch"
                                      Foreground="White"
                                      Background="#444"
                                      BorderBrush="#444">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:Scripturelist">
                                        <TextBlock Text="{Binding Title}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Content="+" Margin="5, 0, 0, 0" Command="{Binding MakeNewScripturelistCommand}" Foreground="White" Background="#444"></Button>
                        </Grid>
                        
                        <!-- Scripture List -->
                        <Grid Grid.Row="3" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="current list" Foreground="#aaa" Margin="0,0,0,10" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding ScriptureList}" SelectedItem="{Binding SelectedScripture}" Background="#111" Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:ScriptureListItem">
                                        <TextBlock Text="{Binding Reference}" Foreground="White"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        
                        <!-- Up/Down/Delete Buttons -->
                        <Grid Grid.Row="4" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
                            <Button Grid.Column="0" Content="↑" Command="{Binding PreviousScriptureCommand}" Background="#333" Foreground="White" Width="40" HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="↓" Command="{Binding NextScriptureCommand}" Background="#333" Foreground="White" Width="40" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                            <Button Grid.Column="2" Content="⇑" Command="{Binding MoveScriptureUpCommand}" Background="#333" Foreground="White" Width="40" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                            <Button Grid.Column="3" Content="⇓" Command="{Binding MoveScriptureDownCommand}" Background="#333" Foreground="White" Width="40" HorizontalContentAlignment="Center" Margin="0,0,5,0"/>
                            <Button Grid.Column="4" Content="Delete" Command="{Binding RemoveScriptureCommand}" Background="#7f1d1d" Foreground="White" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Right Panel: Books, Chapters/Verses, Settings -->
                <Border Grid.Column="1" Background="#222" Padding="10">
                    <Grid ColumnDefinitions="200, Auto, 3*, Auto, 2*">
                        <!-- Books -->
                        <Grid Grid.Column="0" RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="books" Foreground="#aaa" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" Background="#111">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:BibleBook">
                                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <GridSplitter Grid.Column="1" Background="#222" ResizeDirection="Columns" Margin="10, 0, 10, 0"/>

                        <!-- Chapters and Verses -->
                        <Grid Grid.Column="2" RowDefinitions="Auto, Auto, 10, Auto, *, Auto">
                            <!-- Chapters -->
                            <TextBlock Grid.Row="0" Text="chapters" Foreground="#aaa" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}" Background="#111" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:BibleChapter">
                                        <TextBlock Text="{Binding Number}" Foreground="White" Margin="5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <!-- Verses -->
                            <TextBlock Grid.Row="3" Text="verses" Foreground="#aaa" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="4" ItemsSource="{Binding Verses}" SelectedItem="{Binding SelectedVerse}" Background="#111">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:BibleVerse">
                                        <Grid ColumnDefinitions="Auto, *" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="#60a5fa" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="5" Content="+ Add To List" Command="{Binding AddScriptureToPresentationCommand}" Margin="0, 5, 0, 0"></Button>
                        </Grid>

                        <GridSplitter Grid.Column="3" Background="#222" ResizeDirection="Columns" Margin="10, 0, 10, 0"/>

                        <!-- Settings -->
                        <Grid Grid.Column="4" RowDefinitions="*, Auto">
                            <Grid Grid.Row="0" RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="settings" Foreground="#aaa" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="4" Padding="10" Background="#111">
                                    <TextBlock Text="Some settings (blank for now)" Foreground="White" FontSize="16"/>
                                </Border>
                            </Grid>
                            
                            <!-- Button to add to presentation for now -->
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Timer" FontSize="18">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="24" Margin="40" HorizontalAlignment="Center">

                    <!-- Minutes / Seconds input -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="Set time" Foreground="#a1a1aa" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="Auto, 24, Auto" HorizontalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Min" Foreground="#a1a1aa" FontSize="12"
                                           HorizontalAlignment="Center"/>
                                <NumericUpDown x:Name="MinutesSpinner"
                                               Value="{Binding TimerVm.SetMinutes}"
                                               Minimum="0" Maximum="99" Increment="1"
                                               Width="100"
                                               HorizontalContentAlignment="Center"
                                               Background="#27272a" Foreground="White"
                                               BorderBrush="#3f3f46"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text=":" Foreground="#a1a1aa"
                                       FontSize="28" FontWeight="Bold"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Sec" Foreground="#a1a1aa" FontSize="12"
                                           HorizontalAlignment="Center"/>
                                <NumericUpDown x:Name="SecondsSpinner"
                                               Value="{Binding TimerVm.SetSeconds}"
                                               Minimum="0" Maximum="59" Increment="1"
                                               Width="100"
                                               HorizontalContentAlignment="Center"
                                               Background="#27272a" Foreground="White"
                                               BorderBrush="#3f3f46"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Live time display -->
                    <Border Background="#0d0d0d" CornerRadius="14"
                            Padding="48,20" HorizontalAlignment="Center"
                            BorderBrush="#27272a" BorderThickness="1">
                        <Viewbox Stretch="Uniform" Width="320" Height="108">
                            <TextBlock Text="{Binding TimerVm.TimeDisplay}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontFamily="Consolas, Courier New, monospace"/>
                        </Viewbox>
                    </Border>

                    <!-- Controls -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="{Binding TimerVm.PlayPauseBtnText}"
                                Command="{Binding TimerVm.TogglePlayPauseCommand}"
                                Background="#1f538d" Foreground="White"
                                Padding="24,10" FontSize="15" MinWidth="120"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="&#8635;  Reset"
                                Command="{Binding TimerVm.ResetCommand}"
                                Background="#3f3f46" Foreground="White"
                                Padding="24,10" FontSize="15"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Projection display selector -->
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="Projection display" Foreground="#a1a1aa" FontSize="12"/>
                        <ComboBox x:Name="TimerDisplayPicker"
                                  ItemsSource="{Binding AvailableDisplays}"
                                  SelectedItem="{Binding SelectedTimerDisplay}"
                                  PlaceholderText="— none (local only) —"
                                  Background="#27272a" Foreground="White"
                                  MinWidth="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DisplayItemModel">
                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Settings" FontSize="18">
            <StackPanel Spacing="10" Margin="15">
                <TextBlock Text="Connected Displays" FontWeight="Bold" FontSize="14" Foreground="White"/>
                <TextBlock Text="Enable or disable individual screens for projection outputs." FontSize="11" Foreground="#a1a1aa" Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding AvailableDisplays}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DisplayItemModel">
                            <Border Background="#27272a" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <!-- Display Info -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                            <Border Background="#3f3f46" CornerRadius="4" Padding="6,2" IsVisible="{Binding IsPrimary}">
                                                <TextBlock Text="PRIMARY" FontSize="9" FontWeight="Bold" Foreground="#d4d4d8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Resolution}" FontSize="11" Foreground="#a1a1aa" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding IsEnabled}" Foreground="White"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
