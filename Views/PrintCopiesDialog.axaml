<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RevivalSong.Views.PrintCopiesDialog"
        Title="Print Songlist"
        Width="300" Height="200"
        Background="#18181b"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="15" VerticalAlignment="Center">
        <TextBlock Text="How many copies do you want to print?" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>

        <ComboBox x:Name="CopiesCombo" SelectedIndex="3" HorizontalAlignment="Stretch" Margin="0, 10">
            <ComboBoxItem>1 copy</ComboBoxItem>
            <ComboBoxItem>2 copies</ComboBoxItem>
            <ComboBoxItem>3 copies</ComboBoxItem>
            <ComboBoxItem>4 copies (Full Page)</ComboBoxItem>
        </ComboBox>

        <Button Content="Generate Print" Click="OnPrintClicked" Background="#1f538d" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>
</Window>